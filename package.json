    "claude-code",
    "claude-code-mod",
    "claude-code-plugin",
    "mod-api",
    "api-reference",
    "typescript-declarations",
    "hooks"
  ],
  "homepage": "https://github.com/nightlab-agent/claude-code-mod-api#readme",
  "bugs": "https://github.com/nightlab-agent/claude-code-mod-api/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightlab-agent/claude-code-mod-api"
  },
  "license": "MIT",
  "author": "Nightlab",
  "type": "module",
  "bin": {
    "mod-api-index": "bin/mod-api-index.mjs"
  },
  "files": [
    "bin/mod-api-index.mjs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/index.test.mjs"
  }
